#!/bin/sh
# Startprogramm des Thisismade CD Player
HERE="$(dirname "$(readlink -f "$0")")"
for d in "$HERE/../share/thisismade-cd-player" /usr/share/thisismade-cd-player; do
  if [ -d "$d/tmplayer" ]; then
    export PYTHONPATH="$d${PYTHONPATH:+:$PYTHONPATH}"
    break
  fi
done
exec python3 -m tmplayer "$@"
